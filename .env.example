# Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# bcrypt hash of the CMS password (generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())")
CMS_PASSWORD_HASH=

# HS256 signing secret for JWTs (use a long random string)
JWT_SECRET=

# AWS IAM credentials for S3 presign and delete operations
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# S3 bucket name for photo storage
S3_BUCKET=

# CloudFront distribution domain (e.g. d1234abcd.cloudfront.net)
CLOUDFRONT_DOMAIN=

# CORS allowed origins (comma-separated). Defaults to * for development.
# Example: https://emisofia.com,https://www.emisofia.com
CORS_ORIGINS=*
